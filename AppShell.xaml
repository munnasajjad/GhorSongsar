<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GhorSongsar.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GhorSongsar.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="GhorSongsar">

    <TabBar>
        <ShellContent Title="Dashboard" Route="dashboard" ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Title="History" Route="history" ContentTemplate="{DataTemplate views:HistoryPage}" />
        <ShellContent Title="Add" Route="add" ContentTemplate="{DataTemplate views:AddEntryPage}" />
    </TabBar>

</Shell>