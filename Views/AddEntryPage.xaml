<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GhorSongsar.Views.AddEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GhorSongsar.ViewModels"
    x:DataType="vm:AddEntryViewModel"
    Title="Add Entry">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="0">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Type" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Picker ItemsSource="{Binding TypeOptions}" SelectedIndex="{Binding TypeIndex, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Amount (৳)" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="e.g. 500"
                               FontSize="22" FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Category" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Picker ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Date" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <DatePicker Date="{Binding SelectedDate, Mode=TwoWay}" MaximumDate="{Binding MaxDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Note" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Entry Text="{Binding Note}" Placeholder="Optional note" />
                    </VerticalStackLayout>

                    <Button Text="Save Entry" Command="{Binding SaveCommand}" FontSize="16" FontAttributes="Bold"
                            Margin="0,6,0,0" />

                    <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Primary}" FontSize="13"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>